{
  "info": {
    "name": "Customer Support AI Agent",
    "description": "GET /health, POST /api/auth/login, POST /api/chat, cancellation confirmation, and cancellation decisions are implemented. Customer accounts must be provisioned locally.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "authorizationToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Implemented in Phase 1.",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Customer login",
      "description": "Logs in with an administrator-provisioned email/password account and stores the short-lived customer session token. Set customerEmail and customerPassword in a private Postman environment; do not save credentials in a shared collection.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('authorizationToken', body.authorization_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Chat demo",
      "description": "Routes policy questions to grounded RAG and supported current-data requests to tools. Authenticated conversations use bounded, expiring memory for follow-up references. For cancellation, select an optional reason before confirming or recording a non-cancellation decision.",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"What is your refund policy?\",\n  \"conversation_id\": \"demo-session-001\",\n  \"memory_enabled\": true,\n  \"authorization_token\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/chat"
      }
    },
    {
      "name": "Order status via chat",
      "description": "Requires a token from Customer login and an order owned by that customer.",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Where is order ORD-1001?\",\n  \"authorization_token\": \"{{authorizationToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/chat"
      }
    },
    {
      "name": "Order status (planned)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders/ORD-1001"
      }
    },
    {
      "name": "Delivery status (planned)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders/ORD-1001/delivery"
      }
    },
    {
      "name": "Payment status (planned)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders/ORD-1001/payment"
      }
    },
    {
      "name": "Cancellation eligibility (planned)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_id\": \"CUS-001\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/orders/ORD-1001/cancellation-check"
      }
    },
    {
      "name": "Confirm cancellation",
      "description": "Run Chat demo with a cancellation request first. Copy actions[0].confirmation_token into this request, provide a reason code, then explicitly send it.",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-cancel-attempt-0001",
            "description": "Keep this key unchanged when retrying the same confirmation."
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"authorization_token\": \"{{authorizationToken}}\",\n  \"confirmation_token\": \"replace-with-server-issued-token\",\n  \"reason_code\": \"not_provided\",\n  \"reason_text\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/orders/ORD-1001/cancel"
      }
    },
    {
      "name": "Record cancellation decision",
      "description": "Use the same server-issued token to explicitly record a declined or withdrawn cancellation request.",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-cancel-decision-0001",
            "description": "Keep this key unchanged when retrying the same decision."
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"authorization_token\": \"{{authorizationToken}}\",\n  \"confirmation_token\": \"replace-with-server-issued-token\",\n  \"outcome\": \"declined\",\n  \"reason_code\": \"not_provided\",\n  \"reason_text\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/orders/ORD-1001/cancel/decision"
      }
    },
    {
      "name": "Product availability (planned)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/PROD-001/availability"
      }
    }
  ]
}
